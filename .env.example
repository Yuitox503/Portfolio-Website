# Copy to .env.local and fill in from Supabase → Project Settings → API Keys / Data API.
# Both values are safe to expose to the browser; RLS protects the data.
# Never put the service_role / secret key in this project.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "Publishable key" (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
